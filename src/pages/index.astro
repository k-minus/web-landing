---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="site-header">
    <a class="brand" href="#inicio" aria-label="K-MINUS, inicio"><img src={`${baseUrl}assets/images/logo-kminus-transparente.png`} alt="K-MINUS" /></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><span class="sr-only">Abrir menú</span></button>
    <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
      <a href="#proyecto">El proyecto</a><a href="#como-trabajamos">Cómo trabajamos</a><a href="#documentacion">Documentación</a><a href="#galeria">Galería</a><a href="#contacto" class="nav-cta">Colabora</a>
    </nav>
  </header>
  <main id="contenido">
    <section id="inicio" class="hero"><div class="hero-media" aria-hidden="true"><img src={`${baseUrl}assets/images/kminus-accion.webp`} alt="" /></div><div class="hero-overlay"></div><div class="hero-content wrap"><p class="eyebrow light">Ingeniería accesible · Vitoria-Gasteiz</p><h1>La naturaleza<br /><em>no tiene límites.</em></h1><p class="hero-text">Diseñamos movilidad todoterreno accesible para que más personas puedan llegar más lejos.</p><a class="button button-light" href="#proyecto">Conoce K-MINUS</a></div><a class="scroll-hint" href="#proyecto">Descubre el proyecto <i></i></a></section>
    <section id="proyecto" class="intro section wrap"><div class="section-label">01 / El reto</div><div class="intro-copy"><p class="eyebrow">Accesibilidad que avanza</p><h2>Crear caminos donde antes había barreras.</h2><p class="lead">K-MINUS es una iniciativa de estudiantes de ingeniería y ADE de Vitoria-Gasteiz que diseña y desarrolla un vehículo <em>off-road</em> accesible y de bajo coste.</p><p>Queremos que las personas con movilidad reducida puedan disfrutar con seguridad y autonomía de bosques, rutas rurales y zonas de montaña. Para ello, desarrollamos una solución práctica, adaptable y pensada desde la escucha directa a quienes la usarán.</p></div></section>
    <section class="impact-section"><div class="wrap impact-grid"><div class="impact-photo"><img src={`${baseUrl}assets/images/kminus-jornada-compartida.webp`} alt="El equipo de K-MINUS junto a usuarios del vehículo" /></div><div class="impact-copy"><p class="eyebrow">Diseñado con las personas</p><h2>Innovación que se siente en cada recorrido.</h2><p>Trabajamos junto a la Asociación CaMinus, cuya experiencia orienta el diseño mediante un diálogo continuo. El resultado debe responder a necesidades reales: estabilidad, tracción, seguridad y una experiencia de uso intuitiva.</p><p class="quote">La tecnología tiene sentido cuando amplía posibilidades.</p></div></div></section>
    <section id="como-trabajamos" class="section wrap"><div class="section-label">02 / Nuestra forma de avanzar</div><div class="work-heading"><p class="eyebrow">Un equipo, tres perspectivas</p><h2>Conocimiento al servicio de la autonomía.</h2></div><div class="areas"><article><span class="area-no">01</span><h3>Mecánica</h3><p>Chasis, suspensión, ergonomía y estructura para afrontar el terreno con confianza.</p></article><article><span class="area-no">02</span><h3>Electrónica</h3><p>Sistemas de control y potencia para una movilidad segura, eficiente y fiable.</p></article><article><span class="area-no">03</span><h3>Comunicación</h3><p>Una red de colaboración que acerca el proyecto a la comunidad y a sus aliados.</p></article></div></section>
    <section id="documentacion" class="documents section"><div class="wrap"><div class="documents-head"><div><div class="section-label">03 / El conocimiento se convierte en movimiento</div><p class="eyebrow">K-MINUS en la universidad</p><h2>Ingeniería que aprende<br /><em>haciendo servicio.</em></h2></div><p>K-MINUS conecta formación, investigación aplicada e innovación social para desarrollar movilidad todoterreno accesible.</p></div><div class="engineering-grid"><div class="engineering-copy"><p class="eyebrow">Ingeniería de silla de ruedas</p><h3>Un reto real para formar profesionales que transforman.</h3><p>El proyecto, integrado en la convocatoria de innovación educativa i3lab 2025–2026 de la UPV/EHU, plantea al alumnado el diseño y fabricación de prototipos eléctricos para facilitar el senderismo y la montaña a personas con movilidad reducida.</p><p>Es un espacio multidisciplinar donde confluyen diseño, fabricación, electrónica y organización. El aprendizaje parte de una necesidad social concreta y se construye en diálogo con las personas usuarias.</p></div><ul class="engineering-points"><li><strong>Aprendizaje-servicio</strong><span>Conocimiento técnico aplicado a una causa social.</span></li><li><strong>Equipo multidisciplinar</strong><span>Estudiantes de distintas titulaciones y áreas de la Escuela de Ingeniería.</span></li><li><strong>Impacto compartido</strong><span>Más autonomía en la naturaleza y competencias reales para el alumnado.</span></li></ul></div></div></section>
    <section class="m2-section"><div class="wrap"><div class="m2-heading"><div class="section-label">04 / Informe de seguimiento</div><p class="eyebrow light">Modelo M2 · Evolución del prototipo</p><h2>Probar, escuchar,<br /><em>mejorar.</em></h2><p>El desarrollo avanza mediante un ciclo continuo de diseño, fabricación, ensayo y rediseño junto a Caminus y Fundación Vital.</p></div><div class="m2-numbers"><div><strong>2</strong><span>nuevos prototipos funcionales presentados</span></div><div><strong>25</strong><span>participantes en el Campus de Verano STEAM</span></div><div><strong>6</strong><span>presentaciones a centros de Secundaria</span></div></div><div class="m2-progress"><article><span>01</span><h3>Más capaz en el terreno</h3><p>El segundo prototipo redujo su longitud, optimizó la distribución de masas y elevó la altura libre al suelo. El resultado: más estabilidad y mayor capacidad para superar piedras, raíces y rodadas.</p></article><article><span>02</span><h3>Más sencillo de conducir</h3><p>La dirección tipo tanque con joystick facilitó el control. La siguiente evolución rediseñó el sistema para lograr una respuesta más precisa, suave e intuitiva, incluso en espacios reducidos.</p></article><article><span>03</span><h3>Más cerca de las personas</h3><p>Las pruebas con usuarios guiaron las mejoras de accesibilidad, ergonomía, confort y seguridad. Cada versión incorpora lo aprendido para aproximarse a las necesidades reales de uso.</p></article></div></div></section>
    <section class="principles"><div class="wrap"><p class="eyebrow light">Lo que nos mueve</p><div class="principles-list"><span>Accesibilidad</span><span>Autonomía</span><span>Innovación</span><span>Compromiso social</span></div></div></section>
    <section id="galeria" class="gallery section wrap"><div class="gallery-head"><div><div class="section-label">05 / En movimiento</div><p class="eyebrow">Galería</p><h2>Del taller al camino.</h2></div><p>Instantes de una jornada compartida: pruebas, conversaciones y ganas de seguir construyendo.</p></div><div class="gallery-grid"><button class="gallery-item tall" data-full={`${baseUrl}assets/images/kminus-accion.webp`} data-caption="K-MINUS en acción"><img src={`${baseUrl}assets/images/kminus-accion.webp`} alt="Prueba del vehículo K-MINUS" /></button><button class="gallery-item" data-full={`${baseUrl}assets/images/kminus-jornada-compartida.webp`} data-caption="Una jornada de pruebas compartida"><img src={`${baseUrl}assets/images/kminus-jornada-compartida.webp`} alt="Grupo reunido durante la jornada de pruebas" /></button><button class="gallery-item" data-full={`${baseUrl}assets/images/kminus-detalle-vehiculo.webp`} data-caption="Detalles que convierten una idea en movimiento"><img src={`${baseUrl}assets/images/kminus-detalle-vehiculo.webp`} alt="Detalle del vehículo K-MINUS" /></button><button class="gallery-item wide" data-full={`${baseUrl}assets/images/kminus-equipo-pruebas.webp`} data-caption="El equipo y las personas que inspiran el proyecto"><img src={`${baseUrl}assets/images/kminus-equipo-pruebas.webp`} alt="Participantes de K-MINUS durante las pruebas" /></button></div></section>
    <section id="contacto" class="contact"><div class="wrap contact-grid"><div><p class="eyebrow light">¿Quieres sumar?</p><h2>Hagamos que<br />llegar más lejos<br />sea posible.</h2></div><div class="contact-side"><p>K-MINUS es un proyecto abierto a personas con ganas de aprender, aportar y transformar la movilidad.</p><a href="mailto:kminus.ehu@gmail.com" class="button button-light">Escríbenos</a><a class="mail" href="mailto:kminus.ehu@gmail.com">kminus.ehu@gmail.com</a></div></div></section>
  </main>
  <footer class="site-footer wrap"><div><img src={`${baseUrl}assets/images/logo-kminus-transparente.png`} alt="K-MINUS" /><p>Ingeniería sin límites.</p></div><div class="support"><p>Proyecto financiado por</p><img src={`${baseUrl}assets/images/fundacion-vital-logo-desktop.png`} alt="Fundación Vital" /></div><p class="copyright">© {new Date().getFullYear()} K-MINUS · UPV/EHU</p></footer>
  <dialog class="lightbox"><button class="close-lightbox" aria-label="Cerrar imagen">Cerrar</button><img src="" alt="" /><p></p></dialog>
  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('.main-nav');
    const header = document.querySelector<HTMLElement>('.site-header');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
    menuButton?.addEventListener('click', () => { const isOpen = nav?.classList.toggle('open') ?? false; menuButton.setAttribute('aria-expanded', String(isOpen)); });
    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { nav.classList.remove('open'); menuButton?.setAttribute('aria-expanded', 'false'); }));
    const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
    const lightboxImage = lightbox?.querySelector('img'); const lightboxCaption = lightbox?.querySelector('p');
    document.querySelectorAll<HTMLElement>('.gallery-item').forEach((item) => item.addEventListener('click', () => { if (lightboxImage && lightboxCaption && lightbox) { lightboxImage.src = item.dataset.full ?? ''; lightboxImage.alt = item.querySelector('img')?.alt ?? ''; lightboxCaption.textContent = item.dataset.caption ?? ''; lightbox.showModal(); }}));
    lightbox?.querySelector('.close-lightbox')?.addEventListener('click', () => lightbox.close());
    lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
  </script>
</BaseLayout>
