---
import '../styles/global.css';
import '../styles/header.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'K-MINUS · Ingeniería sin límites',
  description = 'K-MINUS: ingeniería accesible para que la naturaleza esté al alcance de todas las personas.'
} = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
